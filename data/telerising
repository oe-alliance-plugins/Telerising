#!/bin/sh
### BEGIN INIT INFO
# Provides:          telerising
# Required-Start:    $network $local_fs $remote_fs
# Required-Stop:     $network $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Telerising API
### END INIT INFO

# OpenATV BusyBox start-stop-daemon service; autostart is enabled in the plugin.
# The updater must stop the service BEFORE changing the current release link.
[ ! -r /etc/default/telerising ] || . /etc/default/telerising
TELERISING_HOME=${TELERISING_HOME:-/media/hdd/telerising/current}
TELERISING_MOUNT=${TELERISING_MOUNT:-/media/hdd}
PIDFILE=${TELERISING_PIDFILE:-/run/telerising.pid}
LOGFILE=${TELERISING_LOGFILE:-/var/volatile/log/telerising.log}
LOCKDIR="${PIDFILE}.lock"
DAEMON="$TELERISING_HOME/api"
SSD=/usr/sbin/start-stop-daemon
STARTUP=/usr/lib/enigma2/python/Plugins/Extensions/Telerising/startup.py
[ -r "$STARTUP" ] || STARTUP="${STARTUP}c"
PROFILES=/usr/lib/enigma2/python/Plugins/Extensions/Telerising/profiles.py
[ -r "$PROFILES" ] || PROFILES="${PROFILES}c"

running() {
    [ -r "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE")
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # Prevent a reused PID or another program named 'api' from matching.
    [ "$(readlink -f "/proc/$pid/exe")" = "$(readlink -f "$DAEMON")" ]
}

start_service() {
    # USB storage may still be mounting while the boot scripts run. Never
    # start against an unmounted directory or create data on the rootfs.
    attempts=0
    while ! mountpoint -q "$TELERISING_MOUNT"; do
        [ "$attempts" -lt 30 ] || { echo "Telerising storage is not mounted: $TELERISING_MOUNT" >&2; return 6; }
        [ "$attempts" -ne 0 ] || echo "Waiting for Telerising storage: $TELERISING_MOUNT"
        sleep 1
        attempts=$((attempts + 1))
    done
    [ -x "$DAEMON" ] || { echo "Telerising binary missing: $DAEMON" >&2; return 5; }
    [ -d "$TELERISING_HOME" ] || return 5
    mkdir -p "$(dirname "$LOGFILE")" || return 1
    # Repair a VPN endpoint routed through its own tunnel before the binary's
    # startup requests. No VPN is required and no VPN configuration is edited.
    python3 "$STARTUP" --wait-network > "${LOGFILE}.startup" 2>&1 || { echo "Telerising network preparation failed; see ${LOGFILE}.startup" >&2; return 7; }
    if running; then echo "Telerising already running"; return 0; fi
    DATA=$(python3 "$PROFILES" "$TELERISING_HOME" 2>> "${LOGFILE}.startup") || { echo "Telerising profile preparation failed" >&2; return 8; }
    rm -f "$PIDFILE"
    "$SSD" -S -b -m -p "$PIDFILE" -x "$DAEMON" -d "$DATA" -O "$LOGFILE" || return 1
    # This confirms process startup only; the plugin must check HTTP readiness.
    sleep 1
    running || { echo "Telerising exited; see $LOGFILE" >&2; return 1; }
    echo "Telerising started"
}

stop_service() {
    if ! running; then
        rm -f "$PIDFILE"
        echo "Telerising not running"
        return 0
    fi
    kill -TERM "$pid" || return 1
    attempts=0
    while running && [ "$attempts" -lt 10 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
    if running; then
        echo "Telerising did not stop; keeping PID file" >&2
        return 1
    fi
    rm -f "$PIDFILE"
    echo "Telerising stopped"
}

case "${1:-}" in
    status)
        if running; then echo "Telerising running (PID $pid)"; exit 0; fi
        echo "Telerising not running"; exit 3 ;;
    start|stop|restart) ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac

umask 077
mkdir "$LOCKDIR" 2>/dev/null || { echo "Telerising service operation already in progress" >&2; exit 1; }
trap 'rmdir "$LOCKDIR"' EXIT
trap 'exit 1' HUP INT TERM
case "$1" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service && start_service ;;
esac
